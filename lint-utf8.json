ect(() => {\r\n        if (chapters.length > 0 && !rangeEnd) {\r\n            setRangeEnd(chapters.length.toString());\r\n        }\r\n    }, [chapters.length, rangeEnd]);\r\n\r\n    // GDrive: Load folders if token exists\r\n    useEffect(() => {\r\n        if (driveToken?.value) {\r\n            loadFolders();\r\n        }\r\n    }, [driveToken?.value]);\r\n\r\n    // GDrive: Init client if setting exists\r\n    useEffect(() => {\r\n        if (clientIdSetting?.value) {\r\n            gdrive.init(clientIdSetting.value as string).catch(console.error);\r\n        }\r\n    }, [clientIdSetting?.value]);\r\n\r\n    const loadFolders = async () => {\r\n        try {\r\n            const folders = await gdrive.listFolders();\r\n            setDriveFolders(folders);\r\n        } catch (error) {\r\n            console.error(\"Error loading folders:\", error);\r\n            toast.error(\"Lá»—i khi táº£i thÆ° má»¥c Drive.\");\r\n        }\r\n    };\r\n\r\n    const handleConnectDrive = async () => {\r\n        if (!clientIdSetting?.value) {\r\n            const id = prompt(\"Vui lĂ²ng nháº­p Google Client ID:\");\r\n            if (id) {\r\n                await db.settings.put({ key: \"gdrive_client_id\", value: id });\r\n                gdrive.init(id);\r\n                toast.info(\"ÄĂ£ lÆ°u Client ID. Báº¥m 'Káº¿t ná»‘i' láº¡i.\");\r\n            }\r\n            return;\r\n        }\r\n        try {\r\n            await gdrive.connect();\r\n            toast.success(\"Káº¿t ná»‘i thĂ nh cĂ´ng!\");\r\n        } catch (error) {\r\n            const errorMessage = error instanceof Error ? error.message : \"Lá»—i káº¿t ná»‘i\";\r\n            toast.error(errorMessage);\r\n        }\r\n    };\r\n\r\n    const handleLogoutDrive = async () => {\r\n        await gdrive.logout();\r\n        setDriveFolders([]);\r\n        setSelectedFolderId(\"root\");\r\n    };\r\n\r\n    const handleManualTokenSave = async () => {\r\n        if (!manualToken.trim()) return;\r\n        let token = manualToken.trim();\r\n        if (token.includes(\"access_token=\")) {\r\n            const match = token.match(/access_token=([^&]+)/);\r\n            if (match) token = match[1];\r\n        }\r\n        try {\r\n            await db.settings.put({ key: \"gdrive_token\", value: token });\r\n            // Directly set the access token on the gdrive instance\r\n            if ('accessToken' in gdrive) {\r\n                (gdrive as unknown as { accessToken: string | null }).accessToken = token;\r\n            }\r\n            const userInfo = await gdrive.getUserInfo(token);\r\n            await db.settings.put({ key: \"gdrive_user\", value: userInfo });\r\n            toast.success(\"ÄĂ£ lÆ°u token!\");\r\n            setShowManualInput(false);\r\n            setManualToken(\"\");\r\n            loadFolders();\r\n        } catch (e) {\r\n            toast.error(\"Token khĂ´ng há»£p lá»‡.\");\r\n        }\r\n    };\r\n\r\n    const handleCreateFolder = async () => {\r\n        const name = prompt(\"Nháº­p tĂªn thÆ° má»¥c má»›i:\");\r\n        if (!name) return;\r\n        try {\r\n            const folder = await gdrive.createFolder(name);\r\n            toast.success(\"ÄĂ£ táº¡o thÆ° má»¥c!\");\r\n            await loadFolders();\r\n            setSelectedFolderId(folder.id);\r\n        } catch (error) {\r\n            toast.error(\"Lá»—i khi táº¡o thÆ° má»¥c\");\r\n        }\r\n    };\r\n\r\n    const handleStartExport = async () => {\r\n        if (!workspace) return;\r\n\r\n        const start = parseInt(rangeStart);\r\n        const end = parseInt(rangeEnd);\r\n\r\n        if (isNaN(start) || isNaN(end) || start < 1 || end < start) {\r\n            return toast.error(\"Khoáº£ng chÆ°Æ¡ng lá»—i!\");\r\n        }\r\n\r\n        const chs = chapters.slice(start - 1, end);\r\n        if (chs.length === 0) return toast.error(\"KhĂ´ng cĂ³ chÆ°Æ¡ng!\");\r\n\r\n        setIsExporting(true);\r\n        setExportProgress(5);\r\n\r\n        try {\r\n            const result = await exportWorkspace({\r\n                workspace,\r\n                chapters: chs,\r\n                target: useDrive ? 'google-drive' : 'filesystem',\r\n                format,\r\n                language: lang,\r\n                rangeStart,\r\n                rangeEnd,\r\n                folderId: selectedFolderId,\r\n                onProgress: (p) => setExportProgress(p)\r\n            });\r\n\r\n            if (result.success) {\r\n                toast.success(useDrive ? \"ÄĂ£ Ä‘áº©y lĂªn Google Drive!\" : \"ÄĂ£ lÆ°u file!\");\r\n            } else {\r\n                toast.error(\"Lá»—i: \" + result.error);\r\n            }\r\n        } catch (error) {\r\n            const errorMessage = error instanceof Error ? error.message : \"Lá»—i khĂ´ng xĂ¡c Ä‘á»‹nh\";\r\n            toast.error(\"Lá»—i xuáº¥t file: \" + errorMessage);\r\n        } finally {\r\n            setIsExporting(false);\r\n            setExportProgress(0);\r\n        }\r\n    };\r\n\r\n    const getManualAuthUrl = () => {\r\n        if (!clientIdSetting?.value) return \"#\";\r\n        const scope = encodeURIComponent(\"https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email\");\r\n        return `https://accounts.google.com/o/oauth2/v2/auth?client_id=${clientIdSetting.value}&redirect_uri=http://localhost:3000&response_type=token&scope=${scope}`;\r\n    };\r\n\r\n    return {\r\n        state: {\r\n            format, lang, rangeStart, rangeEnd,\r\n            isExporting, exportProgress,\r\n            useDrive, driveFolders, selectedFolderId,\r\n            showManualInput, manualToken,\r\n            driveToken, driveUser, clientIdSetting\r\n        },\r\n        actions: {\r\n            setFormat, setLang, setRangeStart, setRangeEnd,\r\n            setUseDrive, setSelectedFolderId, setShowManualInput, setManualToken,\r\n            handleConnectDrive, handleLogoutDrive, handleManualTokenSave,\r\n            handleCreateFolder, handleStartExport, loadFolders, getManualAuthUrl\r\n        }\r\n    };\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Admin\\.gemini\\antigravity\\scratch\\ai-translator\\components\\workspace\\hooks\\useHeuristic.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Admin\\.gemini\\antigravity\\scratch\\ai-translator\\components\\workspace\\hooks\\useHeuristicFilter.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Admin\\.gemini\\antigravity\\scratch\\ai-translator\\components\\workspace\\hooks\\useHeuristicStats.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Admin\\.gemini\\antigravity\\scratch\\ai-translator\\components\\workspace\\hooks\\useOverview.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Admin\\.gemini\\antigravity\\scratch\\ai-translator\\components\\workspace\\hooks\\useReaderConfig.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Admin\\.gemini\\antigravity\\scratch\\ai-translator\\components\\workspace\\hooks\\useReaderInspection.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Admin\\.gemini\\antigravity\\scratch\\ai-translator\\components\\workspace\\hooks\\useReaderKeybinds.ts","messages":[],"suppressedMessag