@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap');
@import "tailwindcss";

@source "../app";
@source "../components";

@plugin "tailwindcss-animate";

@custom-variant dark (&:is(.dark *));

@theme {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);
  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-xl: 1rem;
}

/* ========================================
   THEME SYSTEM - 3 Complete Themes
   ======================================== */

/* 1. LIGHT THEME - Soft, not harsh */
:root {
  color-scheme: light;
  --background: hsl(220 15% 96%);
  --foreground: hsl(220 15% 20%);
  --card: hsl(0 0% 100%);
  --card-foreground: hsl(220 15% 20%);
  --popover: hsl(0 0% 100%);
  --popover-foreground: hsl(220 15% 20%);
  --primary: hsl(250 70% 60%);
  --primary-foreground: hsl(0 0% 100%);
  --secondary: hsl(220 14% 92%);
  --secondary-foreground: hsl(220 15% 20%);
  --muted: hsl(220 14% 94%);
  --muted-foreground: hsl(220 10% 45%);
  --accent: hsl(250 70% 65%);
  --accent-foreground: hsl(0 0% 100%);
  --destructive: hsl(0 70% 55%);
  --destructive-foreground: hsl(0 0% 100%);
  --border: hsl(220 13% 88%);
  --border-strong: hsl(220 13% 82%);
  --input: hsl(220 13% 88%);
  --ring: hsl(250 70% 60%);
  --radius: 0.5rem;
  --sidebar: hsl(220 15% 97%);
  --sidebar-foreground: hsl(220 15% 35%);
  --sidebar-primary: hsl(250 70% 60%);
  --sidebar-primary-foreground: hsl(0 0% 100%);
  --sidebar-accent: hsl(220 14% 94%);
  --sidebar-accent-foreground: hsl(220 15% 20%);
  --sidebar-border: hsl(220 13% 90%);
  --sidebar-ring: hsl(250 70% 60%);
  --reader-max-width: 720px;
  --reader-font-size: 16px;
  --reader-line-height: 1.6;
  --reader-paragraph-spacing: 0.75rem;
  --chinese-font-size: 17px;
  --chinese-font-weight: 400;
  --dialogue-text: hsl(250 70% 55%);
  --dialogue-quote-border: hsl(250 70% 55%);
  --reader-bg-white: hsl(0 0% 100%);
  --reader-bg-cream: hsl(40 33% 98%);
  --reader-bg-sepia: hsl(34 44% 94%);
  --reader-bg-gray: hsl(220 14% 96%);
}

@media (max-width: 768px) {
  :root {
    --chinese-font-size: 18px;
    --chinese-font-weight: 500;
  }
}

/* 2. RAIDEN GRAY THEME - Medium gray, neutral, balanced */
.raiden-gray {
  color-scheme: light;
  --background: hsl(0 0% 92%);
  --foreground: hsl(0 0% 10%);
  --card: hsl(0 0% 96%);
  --card-foreground: hsl(0 0% 10%);
  --popover: hsl(0 0% 96%);
  --popover-foreground: hsl(0 0% 10%);
  --primary: hsl(0 0% 30%);
  --primary-foreground: hsl(0 0% 98%);
  --secondary: hsl(0 0% 88%);
  --secondary-foreground: hsl(0 0% 10%);
  --muted: hsl(0 0% 88%);
  --muted-foreground: hsl(0 0% 40%);
  --accent: hsl(0 0% 88%);
  --accent-foreground: hsl(0 0% 10%);
  --destructive: hsl(0 72% 50%);
  --destructive-foreground: hsl(0 0% 98%);
  --border: hsl(0 0% 82%);
  --border-strong: hsl(0 0% 75%);
  --input: hsl(0 0% 82%);
  --ring: hsl(0 0% 30%);
  --radius: 0.5rem;
  --sidebar: hsl(0 0% 90%);
  --sidebar-foreground: hsl(0 0% 25%);
  --sidebar-primary: hsl(0 0% 30%);
  --sidebar-primary-foreground: hsl(0 0% 98%);
  --sidebar-accent: hsl(0 0% 85%);
  --sidebar-accent-foreground: hsl(0 0% 10%);
  --sidebar-border: hsl(0 0% 82%);
  --sidebar-ring: hsl(0 0% 30%);
  --reader-max-width: 720px;
  --reader-font-size: 16px;
  --reader-line-height: 1.6;
  --reader-paragraph-spacing: 0.75rem;
  --chinese-font-size: 17px;
  --chinese-font-weight: 400;
  --dialogue-text: hsl(0 0% 25%);
  --dialogue-quote-border: hsl(0 0% 25%);
  --reader-bg-white: hsl(0 0% 98%);
  --reader-bg-cream: hsl(40 20% 96%);
  --reader-bg-sepia: hsl(30 15% 94%);
  --reader-bg-gray: hsl(0 0% 92%);
}

/* 3. DARK THEME - Professional, vibrant, depth */
.dark {
  color-scheme: dark;
  --background: hsl(222 47% 11%);
  --foreground: hsl(210 40% 98%);
  --card: hsl(222 47% 14%);
  --card-foreground: hsl(210 40% 98%);
  --popover: hsl(222 47% 14%);
  --popover-foreground: hsl(210 40% 98%);
  --primary: hsl(217 91% 60%);
  --primary-foreground: hsl(222 47% 11%);
  --secondary: hsl(222 47% 18%);
  --secondary-foreground: hsl(210 40% 98%);
  --muted: hsl(217 33% 17%);
  --muted-foreground: hsl(215 20% 65%);
  --accent: hsl(217 91% 60%);
  --accent-foreground: hsl(222 47% 11%);
  --destructive: hsl(0 84% 60%);
  --destructive-foreground: hsl(210 40% 98%);
  --border: hsl(217 33% 21%);
  --border-strong: hsl(217 33% 28%);
  --input: hsl(217 33% 21%);
  --ring: hsl(217 91% 60%);
  --radius: 0.5rem;
  --sidebar: hsl(222 47% 9%);
  --sidebar-foreground: hsl(215 20% 75%);
  --sidebar-primary: hsl(217 91% 60%);
  --sidebar-primary-foreground: hsl(222 47% 11%);
  --sidebar-accent: hsl(217 33% 17%);
  --sidebar-accent-foreground: hsl(210 40% 98%);
  --sidebar-border: hsl(217 33% 17%);
  --sidebar-ring: hsl(217 91% 60%);
  --reader-max-width: 720px;
  --reader-font-size: 16px;
  --reader-line-height: 1.6;
  --reader-paragraph-spacing: 0.75rem;
  --chinese-font-size: 17px;
  --chinese-font-weight: 400;
  --dialogue-text: hsl(217 91% 65%);
  --dialogue-quote-border: hsl(217 91% 65%);
  --reader-bg-white: hsl(222 47% 14%);
  --reader-bg-cream: hsl(222 40% 16%);
  --reader-bg-sepia: hsl(222 35% 18%);
  --reader-bg-gray: hsl(222 30% 20%);
}

/* 4. MACOS THEME - GPT Specs (Ventura/Sonoma) */
.macos {
  color-scheme: light;

  /* 1️⃣ NỀN TỔNG - Colder grays */
  --background: #F5F5F7;
  --foreground: #1C1C1E;
  --card: #FFFFFF;
  --card-foreground: #1C1C1E;
  --popover: #FFFFFF;
  --popover-foreground: #1C1C1E;

  /* Primary - System Blue */
  --primary: #007AFF;
  --primary-foreground: #FFFFFF;

  /* Secondary & Muted */
  --secondary: #F5F5F7;
  --secondary-foreground: #1C1C1E;
  --muted: #F2F2F7;
  --muted-foreground: #6E6E73;

  /* 8️⃣ ACCENT PURPLE - macOS purple */
  --accent: #5856D6;
  --accent-foreground: #FFFFFF;

  /* Destructive - macOS Red */
  --destructive: #FF3B30;
  --destructive-foreground: #FFFFFF;

  /* 2️⃣ BORDERS - E5E5EA */
  --border: #E5E5EA;
  --border-strong: #D1D1D6;
  --input: #E5E5EA;
  --ring: #007AFF;

  /* Radius - 12px for panels */
  --radius: 0.75rem;

  /* Sidebar */
  --sidebar: #F3F3F6;
  --sidebar-foreground: #1C1C1E;
  --sidebar-primary: #5856D6;
  --sidebar-primary-foreground: #FFFFFF;
  --sidebar-accent: #EDEDF3;
  --sidebar-accent-foreground: #1C1C1E;
  --sidebar-border: #E5E5EA;
  --sidebar-ring: #5856D6;

  /* Reader */
  --reader-max-width: 720px;
  --reader-font-size: 16px;
  --reader-line-height: 1.6;
  --reader-paragraph-spacing: 0.75rem;
  --chinese-font-size: 17px;
  --chinese-font-weight: 400;
  --dialogue-text: #007AFF;
  --dialogue-quote-border: #007AFF;
  --reader-bg-white: #FFFFFF;
  --reader-bg-cream: #F5F5F7;
  --reader-bg-sepia: #F2F2F7;
  --reader-bg-gray: #F5F5F7;

  /* macOS-specific extras - GPT text hierarchy */
  --macos-text-primary: #1C1C1E;
  --macos-text-secondary: #6E6E73;
  --macos-text-muted: #8E8E93;
  --macos-text-disabled: #AEAEB2;
  --macos-accent-green: #34C759;
  --macos-accent-orange: #FF9500;
  --macos-accent-purple: #5856D6;
}

/* macOS Utilities - Frosted Glass & Shadows */
@layer utilities {
  .macos-blur {
    backdrop-filter: blur(20px) saturate(180%);
    background-color: rgba(255, 255, 255, 0.8);
  }

  .macos-blur-heavy {
    backdrop-filter: blur(40px) saturate(180%);
    background-color: rgba(255, 255, 255, 0.7);
  }

  .macos-shadow-sm {
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 1px 4px rgba(0, 0, 0, 0.06);
  }

  .macos-shadow-md {
    box-shadow:
      0 4px 8px rgba(0, 0, 0, 0.08),
      0 2px 4px rgba(0, 0, 0, 0.04);
  }

  .macos-shadow-lg {
    box-shadow:
      0 16px 32px rgba(0, 0, 0, 0.12),
      0 4px 8px rgba(0, 0, 0, 0.06);
  }
}

@layer base {
  * {
    border-color: var(--border);
    box-sizing: border-box;
  }

  body {
    background-color: var(--background);
    color: var(--foreground);
    min-height: 100vh;
    margin: 0;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', sans-serif;
    font-feature-settings: "rlig" 1, "calt" 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.5;
  }

  /* macOS Typography - San Francisco weights */
  .macos body {
    font-weight: 400;
    line-height: 1.6;
  }

  .macos h1,
  .macos h2,
  .macos h3 {
    font-weight: 600;
    line-height: 1.4;
  }

  .macos button,
  .macos .font-medium {
    font-weight: 500;
  }

  .macos .font-semibold {
    font-weight: 600;
  }

  .macos .font-bold {
    font-weight: 700;
  }

  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  :focus:not(:focus-visible) {
    outline: none;
  }
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: hsl(var(--muted-foreground) / 0.4);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: hsl(var(--muted-foreground) / 0.6);
}

* {
  scrollbar-width: thin;
  scrollbar-color: hsl(var(--muted-foreground) / 0.4) transparent;
}

/* macOS Micro-interactions & Polish */
.macos button:not(:disabled) {
  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

.macos button:not(:disabled):active {
  transform: scale(0.98);
}

.macos .hover\:scale-105:hover {
  transform: scale(1.05);
}

/* macOS Smooth Transitions */
.macos * {
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
}

/* macOS Focus Ring - System Blue */
.macos :focus-visible {
  outline: 2px solid #007AFF;
  outline-offset: 2px;
  border-radius: 4px;
}

/* ===== MACOS COMPONENT STYLING - Claude's Spec ===== */

/* PHASE 1: QUICK WINS */

/* Sidebar Buttons - 32px height, blue tint active */
.macos nav button {
  min-height: 32px;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
  background-color: transparent;
  color: #1D1D1F;
}

.macos nav button:hover:not([class*="bg-sidebar-accent"]) {
  background-color: #E8E8ED;
}

/* Active state - 8% blue tint + left border (macOS style) */
.macos nav button[class*="bg-sidebar-accent"] {
  background-color: rgba(0, 122, 255, 0.08);
  color: #007AFF;
  font-weight: 600;
  border-left: 3px solid #007AFF;
  margin-left: -3px;
  padding-left: 12px;
}

.macos nav button[class*="bg-sidebar-accent"]:hover {
  background-color: rgba(0, 122, 255, 0.12);
}

/* Chapter Rows - 52px height, rgba borders */
.macos [class*="ChapterRow"] {
  min-height: 52px !important;
  padding: 12px 16px !important;
  border-radius: 8px;
  border: 1px solid rgba(0, 0, 0, 0.06) !important;
}

.macos [class*="ChapterRow"]:hover {
  background-color: #F5F5F7 !important;
  border-color: rgba(0, 0, 0, 0.08) !important;
}

/* All Buttons - 8px radius */
.macos button:not(nav button) {
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  min-height: 32px;
}

/* PRIMARY BUTTONS - Force System Blue (with !important for inline styles) */
.macos button[class*="primary"],
.macos button[class*="Primary"],
.macos button[class*="bg-primary"],
.macos button.bg-primary,
.macos button[class*="bg-purple"],
.macos button.bg-purple,
.macos button[class*="bg-violet"],
.macos button.bg-violet,
.macos button[class*="bg-indigo"],
.macos button.bg-indigo,
.macos button[class*="from-violet"],
.macos button[class*="from-purple"],
.macos button[class*="from-indigo"] {
  background: #007AFF !important;
  background-image: none !important;
  color: #FFFFFF !important;
  border-color: #007AFF !important;
}

.macos button[class*="primary"]:hover,
.macos button[class*="Primary"]:hover,
.macos button[class*="bg-primary"]:hover,
.macos button.bg-primary:hover,
.macos button[class*="from-violet"]:hover,
.macos button[class*="from-purple"]:hover {
  background: #0051D5 !important;
  background-image: none !important;
  border-color: #0051D5 !important;
}

/* SECONDARY BUTTONS - Gray */
.macos button[class*="secondary"],
.macos button[class*="Secondary"],
.macos button[class*="outline"],
.macos button[class*="ghost"] {
  background-color: #F5F5F7;
  color: #1D1D1F;
  border: 1px solid rgba(0, 0, 0, 0.06);
}

.macos button[class*="secondary"]:hover,
.macos button[class*="outline"]:hover,
.macos button[class*="ghost"]:hover {
  background-color: #E8E8ED;
  border-color: rgba(0, 0, 0, 0.08);
}

/* DESTRUCTIVE BUTTONS */
.macos button[class*="destructive"],
.macos button[class*="danger"],
.macos button[class*="bg-red"] {
  background-color: #FF3B30;
  color: #FFFFFF;
}

.macos button[class*="destructive"]:hover,
.macos button[class*="danger"]:hover {
  background-color: #E60000;
}

/* DARK BUTTONS (CHỐT, etc) - Convert to Blue */
.macos button[class*="bg-black"],
.macos button[class*="bg-gray-900"],
.macos button[class*="bg-slate-900"] {
  background-color: #1D1D1F;
  color: #FFFFFF;
}

.macos button[class*="bg-black"]:hover {
  background-color: #2D2D2F;
}

/* PHASE 2: SHADOWS */

.macos aside {
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 4px rgba(0, 0, 0, 0.06);
}

.macos [class*="Card"] {
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 4px rgba(0, 0, 0, 0.06);
  border-radius: 12px;
}

/* PHASE 3: POLISH */

/* Header blur */
.macos header {
  backdrop-filter: blur(20px) saturate(180%);
  background-color: rgba(255, 255, 255, 0.8) !important;
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
}

/* Checkboxes */
.macos input[type="checkbox"] {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  accent-color: #007AFF;
}

/* Typography */
.macos h1 {
  font-size: 18px;
  font-weight: 700;
}

.macos h2 {
  font-size: 16px;
  font-weight: 600;
}

.macos p {
  font-size: 13px;
}

/* ===== MACOS POLISH - COMPREHENSIVE ===== */

/* Badges - macOS System Colors */
.macos span[class*="badge"],
.macos span[class*="Badge"],
.macos span[class*="status"] {
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.01em;
  border: 1px solid transparent;
}

/* Success/Green badges - macOS Green */
.macos span[class*="success"],
.macos span[class*="green"],
.macos [class*="status"][class*="done"],
.macos [class*="status"][class*="completed"],
.macos span[class*="bg-emerald"],
.macos span[class*="bg-green"] {
  background-color: rgba(52, 199, 89, 0.1);
  color: #0F7B3F;
  border-color: rgba(52, 199, 89, 0.2);
}

/* Warning/Orange badges - macOS Orange */
.macos span[class*="warning"],
.macos span[class*="orange"],
.macos span[class*="pending"],
.macos span[class*="bg-yellow"],
.macos span[class*="bg-orange"],
.macos span[class*="bg-amber"] {
  background-color: rgba(255, 149, 0, 0.1);
  color: #B25000;
  border-color: rgba(255, 149, 0, 0.2);
}

/* Error/Red badges - macOS Red */
.macos span[class*="error"],
.macos span[class*="red"],
.macos span[class*="failed"],
.macos span[class*="bg-red"] {
  background-color: rgba(255, 59, 48, 0.1);
  color: #C41E3A;
  border-color: rgba(255, 59, 48, 0.2);
}

/* Info/Blue badges - macOS Blue */
.macos span[class*="info"],
.macos span[class*="blue"],
.macos span[class*="bg-blue"],
.macos span[class*="bg-sky"],
.macos span[class*="bg-cyan"] {
  background-color: rgba(0, 122, 255, 0.1);
  color: #0051D5;
  border-color: rgba(0, 122, 255, 0.2);
}

/* Purple/Violet badges - Convert to Blue */
.macos span[class*="bg-purple"],
.macos span[class*="bg-violet"],
.macos span[class*="bg-indigo"] {
  background-color: rgba(0, 122, 255, 0.1);
  color: #0051D5;
  border-color: rgba(0, 122, 255, 0.2);
}

/* Modals/Dialogs */
.macos [class*="Dialog"],
.macos [class*="Modal"],
.macos [role="dialog"] {
  box-shadow:
    0 16px 32px rgba(0, 0, 0, 0.12),
    0 4px 8px rgba(0, 0, 0, 0.06);
  border-radius: 12px;
  border: 1px solid rgba(0, 0, 0, 0.06);
}

/* Typography - macOS San Francisco */
.macos h1 {
  font-size: 22px;
  font-weight: 700;
  color: #1D1D1F !important;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.macos h2 {
  font-size: 17px;
  font-weight: 600;
  color: #1D1D1F !important;
  line-height: 1.35;
  letter-spacing: -0.01em;
}

.macos h3 {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F !important;
}

.macos p {
  font-size: 13px;
  line-height: 1.5;
  color: #1D1D1F !important;
}

/* Force readable text colors */
.macos [class*="text-muted"],
.macos .text-muted-foreground,
.macos span[class*="text-muted"],
.macos div[class*="text-muted"] {
  color: #86868B !important;
}

.macos [class*="text-gray"],
.macos [class*="text-slate"],
.macos span[class*="text-gray"],
.macos div[class*="text-gray"] {
  color: #86868B !important;
}

/* ALL text should be readable by default */
.macos span,
.macos div,
.macos li {
  color: #1D1D1F;
}

/* CRITICAL: Override opacity classes */
.macos [class*="/60"],
.macos [class*="/70"],
.macos [class*="/80"],
.macos [class*="/90"] {
  opacity: 1 !important;
}

/* Force foreground color without opacity */
.macos [class*="text-foreground/"],
.macos [class*="text-muted-foreground/"] {
  color: #86868B !important;
  opacity: 1 !important;
}

/* Specific overrides for common patterns */
.macos [class*="text-purple"],
.macos [class*="text-violet"],
.macos [class*="text-indigo"] {
  color: #007AFF !important;
}

/* Override dark theme colors for light macOS */
.macos .text-gray-300,
.macos .text-gray-400,
.macos [class*="text-gray-3"],
.macos [class*="text-gray-4"] {
  color: #1D1D1F !important;
}

.macos .text-blue-200,
.macos .text-blue-300,
.macos [class*="text-blue-2"],
.macos [class*="text-blue-3"] {
  color: #007AFF !important;
}

/* CRITICAL: Override gradient backgrounds to solid white */
.macos [class*="from-purple"],
.macos [class*="from-pink"],
.macos [class*="from-blue"],
.macos [class*="to-purple"],
.macos [class*="to-pink"],
.macos [class*="bg-linear"] {
  background: #FFFFFF !important;
  background-image: none !important;
}

/* Override semi-transparent backgrounds */
.macos [class*="bg-purple-500/"],
.macos [class*="bg-blue-500/"],
.macos [class*="bg-black/"] {
  background-color: #F5F5F7 !important;
}

.macos small,
.macos [class*="text-xs"] {
  font-size: 11px;
  color: #86868B !important;
}

/* Labels should be readable */
.macos label {
  color: #1D1D1F !important;
  font-weight: 500;
}

/* Tables/Lists - macOS style */
.macos table,
.macos [role="table"] {
  border-collapse: separate;
  border-spacing: 0;
}

.macos table th {
  background-color: #F5F5F7;
  color: #86868B;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 8px 12px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.macos table td {
  padding: 12px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.macos table tr:hover td {
  background-color: #F5F5F7;
}

/* Hover States */
.macos button:hover:not(:disabled) {
  transform: translateY(-0.5px);
}

.macos button:active:not(:disabled) {
  transform: scale(0.98);
}

/* Input Fields */
.macos input[type="text"]:focus,
.macos input[type="email"]:focus,
.macos input[type="password"]:focus,
.macos textarea:focus,
.macos select:focus {
  border-color: #007AFF;
  outline: none;
  box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.1);
}

/* Dividers */
.macos hr,
.macos [class*="divider"],
.macos [class*="separator"] {
  border: none;
  height: 1px;
  background-color: rgba(0, 0, 0, 0.06);
  margin: 16px 0;
}

/* Scrollbars - macOS style */
.macos ::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.macos ::-webkit-scrollbar-track {
  background: transparent;
}

.macos ::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 4px;
}

.macos ::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.3);
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
  }
}

/* Notification auto-dismiss animation */
@keyframes shrink-width {
  from {
    width: 100%;
  }

  to {
    width: 0%;
  }
}

::selection {
  background-color: hsla(217, 91%, 60%, 0.2);
  color: inherit;
}

.reader-text,
.selectable,
input,
textarea {
  user-select: text !important;
  -webkit-user-select: text !important;
}