{
  "name": "raiden-ai-translator",
  "version": "2.7.5",
  "private": true,
  "scripts": {
    "//": "=========================",
    "// 🌐 WEB (Next.js)": "=========================",
    "web:dev": "next dev -p 3000 --webpack",
    "web:build": "next build",
    "web:start": "next start",
    "// 🖥️ TAURI (Desktop)": "=========================",
    "tauri:dev": "tauri dev",
    "tauri:dev:fast": "powershell -Command \"$env:RUST_LOG='error'; tauri dev\"",
    "tauri:build": "tauri build",
    "// ⚡ FAST PATH (hay dùng nhất)": "=========================",
    "dev": "pnpm run web:dev",
    "d": "pnpm run dev:fast",
    "dev:tauri": "pnpm run tauri:dev",
    "dev:fast": "pnpm run tauri:dev:fast",
    "// 🔍 LINT & CHECK": "=========================",
    "lint": "eslint",
    "lint:any": "pnpm run lint -- 2>&1 | findstr \"@typescript-eslint/no-explicit-any\"",
    "lint:unused": "pnpm run lint -- 2>&1 | findstr \"no-unused-vars\"",
    "typecheck": "tsc --noEmit",
    "// 🧠 DB / DATA (Dexie)": "=========================",
    "db:export": "node scripts/db-export.mjs",
    "db:import": "node scripts/db-import.mjs",
    "db:reset:ui": "node scripts/db-reset-ui-preferences.mjs",
    "// 📦 BUILD / RELEASE": "=========================",
    "build:web": "pnpm run web:build",
    "build:tauri": "pnpm run tauri:build",
    "build:release": "pnpm run web:build && pnpm run tauri:build",
    "build:fast": "pnpm run f9",
    "build": "pnpm run web:build",
    "// ⚡ LEGACY / SHORTCUTS": "=========================",
    "f9": "node scripts/build-ultra-fast.mjs",
    "bxf": "node scripts/build-ultra-fast.mjs",
    "// 🧪 META / TOOLING": "=========================",
    "meta:clean": "rimraf .next src-tauri/target",
    "meta:info": "node scripts/system-info.mjs",
    "meta:version-sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/plugin-http": "^2.5.6",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "epubjs": "^0.3.93",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "p-limit": "^7.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/cli": "^2.2.7",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@types/node": "^20",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}